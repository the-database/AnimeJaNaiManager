<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../AnimeJaNaiConfEditor/Services/PlayerSettings/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../AnimeJaNaiConfEditor/Services/LaunchArgs.cs" Link="Production/LaunchArgs.cs" />
    <Compile Include="../../AnimeJaNaiConfEditor/Services/UiState.cs" Link="Production/UiState.cs" />
    <Compile Include="../../AnimeJaNaiConfEditor/ViewModels/ViewModelBase.cs" Link="Production/ViewModelBase.cs" />
    <Compile Include="../../AnimeJaNaiConfEditor/ViewModels/PlayerSettingsViewModel.cs" Link="Production/PlayerSettingsViewModel.cs" />
    <EmbeddedResource Include="../../AnimeJaNaiConfEditor/Services/PlayerSettings/player-options.json" LogicalName="AnimeJaNaiManager.PlayerSettings.player-options.json" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
  </ItemGroup>
</Project>
